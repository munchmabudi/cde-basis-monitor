# Copy this file to ".env" (same folder as monitor_cde_basis.js) and fill in what you need.
# ".env" is git-ignored -- never commit it or share it. Everything here is optional.

# Telegram alerts (leave blank to get console-only alerts)
CDE_BASIS_TELEGRAM_BOT_TOKEN=
CDE_BASIS_TELEGRAM_CHAT_ID=

# Dashboard port (default 8080)
# CDE_BASIS_PORT=8080

# Alert defaults (also editable live in the dashboard at /alerts/settings)
# CDE_ALERT_MAJORS=BTC,ETH
# CDE_ALERT_MAJOR_APY=20
# CDE_ALERT_ALT_APY=30
# CDE_ALERT_CLEAR_APY=10

# Keep this many days of polls in the active log; older ones move to data/archive/ (default 60)
# CDE_BASIS_MAX_LOG_DAYS=60
